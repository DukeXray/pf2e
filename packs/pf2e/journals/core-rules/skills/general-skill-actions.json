            "text": {
                "content": "<h1>General Skill Actions <span class=\"title-info\">General skill actions are skill actions that can be used with multiple different skills. When you use a general skill action, you might use your modifier from any skill that lists it as one of the skill’s actions, depending on the situation.</span></h1>\n<table>\n    <thead>\n        <tr>\n            <th>\n                <p>General Skill Action</p>\n            </th>\n            <th>\n                <p>Proficiency</p>\n            </th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>\n                <p>Decopher Writing</p>\n            </td>\n            <td>\n                <p>Trained</p>\n            </td>\n        </tr>\n        <tr>\n            <td>\n                <p>Earn Income</p>\n            </td>\n            <td>\n                <p>Trained</p>\n            </td>\n        </tr>\n        <tr>\n            <td>\n                <p>Identify Magic</p>\n            </td>\n            <td>\n                <p>Trained</p>\n            </td>\n        </tr>\n        <tr>\n            <td>\n                <p>Learn A Spell</p>\n            </td>\n            <td>\n                <p>Trained</p>\n            </td>\n        </tr>\n        <tr>\n            <td>\n                <p>Recall Knowledge</p>\n            </td>\n            <td>\n                <p>Untrained</p>\n            </td>\n        </tr>\n        <tr>\n            <td>\n                <p>Subsist</p>\n            </td>\n            <td>\n                <p>Untrained</p>\n            </td>\n        </tr>\n    </tbody>\n</table>",
